# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=

# Auth (JWT)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# URL: https://yourdomain.com/api/v1/payment/webhook
# Events: payment.captured, payment.failed
# Copy the generated secret here
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp click-to-chat number shown to customers (digits only, country code first)
SHOP_WHATSAPP_NUMBER=

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Groq (AI search / shopping assistant / product description generation)
GROQ_API_KEY=
# Optional — falls back to a built-in default model if unset
GROQ_MODEL=

# Redis (rate limiting, caching, BullMQ email queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email (order/payment/shipping notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShopName <youremail@example.com>
